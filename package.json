{
  "name": "dexalot-trade-kit",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @dexalot/trade-core build && pnpm --filter @dexalot/trade-mcp build && pnpm --filter @dexalot/trade-cli build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "test:unit": "pnpm --filter @dexalot/trade-core test:unit && pnpm --filter @dexalot/trade-cli test:unit && pnpm --filter @dexalot/trade-mcp test:unit",
    "test:coverage": "c8 --reporter=lcov --reporter=text --src=packages/core/src --src=packages/cli/src node_modules/.bin/tsx --test packages/core/test/*.test.ts packages/cli/test/*.test.ts packages/mcp/test/*.test.ts",
    "test": "c8 --reporter=lcov --reporter=text --src=packages/core/src --src=packages/cli/src node_modules/.bin/tsx --test packages/core/test/*.test.ts packages/cli/test/*.test.ts packages/mcp/test/*.test.ts",
    "pretest": "pnpm --filter @dexalot/trade-core build && pnpm --filter @dexalot/trade-cli build"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/node": "^25.2.2",
    "c8": "^10.1.3",
    "ethers": "^6.16.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "hono@<4.12.25": ">=4.12.25",
      "undici@<6.27.0": ">=6.27.0"
    }
  }
}
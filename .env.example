# Dexalot Trade Kit — environment variable overrides
# Any value set here takes precedence over the matching ~/.dexalot/config.toml field.

# Wallet private key (0x-prefixed 32-byte hex)
export DEXALOT_PRIVATE_KEY="0x_replace_me_with_a_32_byte_hex"

# Vault key to decrypt a profile whose key lives in the secrets vault (key_source = "vault",
# the default when you choose "encrypt" in `dexalot config init`). The wizard prints this once.
# Prefer sourcing from your OS keychain over hardcoding, e.g. on macOS:
#   export DEXALOT_VAULT_KEY="$(security find-generic-password -a "$USER" -s dexalot-vault -w)"
# export DEXALOT_VAULT_KEY="..."

# Legacy: passphrase for an older `encrypted_key` (ethers keystore) profile, still supported.
# export DEXALOT_KEYSTORE_PASSWORD="..."

# Network: mainnet | testnet | devnet (default: mainnet)
# export DEXALOT_NETWORK="testnet"

# Override the REST API base URL (advanced, e.g. devnet alternate host)
# export DEXALOT_API_BASE_URL="https://api.dexalot-dev.com/api"

# Override the SDK parentEnv (advanced)
# export DEXALOT_PARENT_ENV="fuji-multi-avax"

# HTTP timeout in milliseconds (default 15000)
# export DEXALOT_TIMEOUT_MS="20000"

# Per-chain RPC override lists (comma-separated)
# export DEXALOT_RPC_43114="https://api.avax.network/ext/bc/C/rpc,https://avalanche-c-chain.publicnode.com"
# export DEXALOT_RPC_43113="https://api.avax-test.network/ext/bc/C/rpc"

# Use the timestamped auth signature (backend-gated; default false)
# export DEXALOT_TIMESTAMPED_AUTH="true"

# Disable the npm update check banner
# export DEXALOT_UPDATE_CHECK="false"

# Audit log retention in days (default 30)
# export DEXALOT_LOG_RETENTION_DAYS="60"

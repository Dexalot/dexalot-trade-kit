{
  "name": "@dexalot/trade-mcp",
  "version": "0.1.0",
  "description": "Dexalot MCP Server — Model Context Protocol server for the Dexalot DEX",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dexalot-trade-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:unit": "node --import tsx/esm --test test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dexalot",
    "mcp",
    "model-context-protocol",
    "trading",
    "dex"
  ],
  "dependencies": {
    "@dexalot/dexalot-sdk": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@walletconnect/sign-client": "^2.23.10",
    "ethers": "^6.16.0",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.3.4",
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "@dexalot/trade-core": "workspace:*",
    "@types/node": "^25.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
